# Meshed : exemple de configuration.
# Copier ce fichier en `.env` (jamais committé) et adapter les valeurs.
# Ne JAMAIS mettre de valeur secrète réelle dans ce fichier : il est public.

# APP_ENV : environnement d'exécution, « development », « staging » ou « production ».
# Variable absente = « production » ; toute autre valeur, casse comprise, est refusée.
# Les composants simulés (ADAPTER_AUTH « personas », ADAPTER_CLOCK « simulated », ADAPTER_AUDIT_LOG « in-memory ») ne sont
# autorisés qu'en development et staging. Règle complète : docs/technique/architecture-cible-et-mocks.md, §2.2.
# Lecture prévue par loadConfig(process.env) (US-02c, pas encore écrit).
# APP_ENV=development

# Choix des adaptateurs pour chaque contrat (voir docs/technique/architecture-cible-et-mocks.md).
# Valeurs possibles, sauf pour ADAPTER_CLOCK, ADAPTER_AUTH et ADAPTER_AUDIT_LOG : mock (simulé, valeur par défaut)
# ou real (réel, lorsqu'il existera). Un composant simulé sera refusé en production : à revoir
# adaptateur par adaptateur.
# ADAPTER_CLOCK : « system » (horloge de la machine, valeur par défaut si absente, permise dans tous
# les environnements) ou « simulated » (horloge simulée, development et staging uniquement ; exige un
# instant de départ : voir src/composition/create-clock.ts).
# Toute autre valeur, casse comprise, est refusée. Lecture prévue par loadConfig (US-02c, pas encore écrit).
ADAPTER_CLOCK=system

# ADAPTER_AUTH : seule valeur acceptée « personas » (six personas fictifs, aux jetons devinables :
# development et staging UNIQUEMENT, refusé en production). Aucune valeur par défaut : variable absente
# = erreur ; « mock » et toute autre valeur, casse comprise, sont refusées (voir
# src/composition/create-auth-provider.ts). Exception volontaire à « mock par défaut » : un oubli de
# configuration ne doit pas activer des jetons devinables. Lecture prévue par loadConfig (US-02c, pas encore écrit).
# ADAPTER_AUTH=personas

ADAPTER_STORAGE=mock
ADAPTER_ACCESS_POLICY=mock
ADAPTER_EMAIL=mock
ADAPTER_COMPANY_REGISTRY=mock
ADAPTER_SCHEDULER=mock
ADAPTER_CONTACT_DETECTOR=mock
ADAPTER_FILE_STORAGE=mock

# ADAPTER_AUDIT_LOG : seule valeur acceptée « in-memory » (journal d'audit en mémoire, perdu à l'arrêt
# du processus : development et staging UNIQUEMENT, refusé en production). Aucune valeur par défaut :
# variable absente = erreur ; « mock » et toute autre valeur, casse comprise, sont refusées (voir
# src/composition/create-audit-log.ts). Exception volontaire à « mock par défaut » : un oubli de
# configuration ne doit pas activer un journal non conservé. Lecture prévue par loadConfig (US-02c, pas encore écrit).
# ADAPTER_AUDIT_LOG=in-memory

ADAPTER_CV_PARSER=mock
